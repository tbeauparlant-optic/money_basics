  {
    "name": "tips",
    "type": "group",
    "label": "Facilitator engaging tips per category",
    "importance": "high",
    "fields": [
      {
        "name": "simple",
        "type": "text",
        "widget": "textarea",
        "label": "Simple Category Tips",
        "default": "Filler Tip: To make simple topics engaging, use quick-fire quizzes, interactive matching games, and real-life scenario simulations to keep learners active."
      },
      {
        "name": "dry",
        "type": "text",
        "widget": "textarea",
        "label": "Dry Category Tips",
        "default": "Filler Tip: Dry topics (like terms of service or regulation details) can be made engaging by using storytelling, gamification elements, or group problem-solving exercises."
      },
      {
        "name": "complex",
        "type": "text",
        "widget": "textarea",
        "label": "Complex Category Tips",
        "default": "Filler Tip: For complex topics, break them into clear modular micro-lessons, use visual flowcharts, step-by-step progress trackers, and detailed case studies."
      },
      {
        "name": "hot",
        "type": "text",
        "widget": "textarea",
        "label": "Hot-button Category Tips",
        "default": "Filler Tip: Engage learners on hot-button topics by facilitating anonymous voting, structuring debates, using roleplay, and offering space for reflection."
      }
    ]
  },
