{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://money-basics.local/schemas/workshop.schema.json",
  "title": "Workshop",
  "type": "object",
  "required": ["id", "title", "order"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^workshop-[0-9]{2}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "order": {
      "type": "integer",
      "minimum": 0
    },
    "description": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
